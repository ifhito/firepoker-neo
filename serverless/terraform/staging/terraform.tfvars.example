aws_region              = "ap-northeast-1"
stack_name              = "firepocker-serverless"
lambda_package_path     = "../../dist/websocket-handler.zip"
session_creation_lambda_package_path = "../../dist/session-creation-handler.zip"
notion_secret_name      = "firepocker/serverless/notion"
notion_secret_json      = <<EOT
{"NOTION_TOKEN":"placeholder","NOTION_PBI_DB_ID":"placeholder"}
EOT
static_site_bucket_name = "firepocker-staging-serverless-web"
cloudfront_domain_aliases = [
  "staging.example.com"
]
certificate_arn        = "arn:aws:acm:ap-northeast-1:123456789012:certificate/abcd-efgh"
log_bucket_name        = "firepocker-staging-cf-logs"
cloudfront_price_class = "PriceClass_100"
connections_threshold  = 10
sns_topic_arn          = "arn:aws:sns:ap-northeast-1:123456789012:serverless-alerts"
lambda_environment_overrides = {
  WS_CALLBACK_ENDPOINT = "https://example.execute-api.ap-northeast-1.amazonaws.com/staging"
}
session_creation_max_connections = 10
session_creation_allowed_origin  = "https://staging.example.com"
